# Signing key used by the API for JWT tokens.
# Generate a new one for production, e.g.: openssl rand -base64 48
JWT_KEY=grandstay-docker-dev-signing-key-change-before-production-4f8a6c0e9d7b3a5f1c8e

# URL the browser uses to reach the API. Baked into the web build.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
