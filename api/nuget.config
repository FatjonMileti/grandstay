<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Optional: Force NuGet to store the global restore cache inside your project folder too -->
    <add key="globalPackagesFolder" value="./.nuget-cache/" />
  </config>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="ProjectLocalFeed" value="./local-packages" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
